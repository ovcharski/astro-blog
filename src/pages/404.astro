---
import { SITE } from "@config";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LinkButton from "@components/LinkButton.astro";
---

<Layout
  title={`404 Not Found | ${SITE.title}`}
  description="This page doesn't exist, or it wandered off somewhere. Head back home, browse all the posts, or search the blog to find what you were after."
>
  <Header />

  <main id="main-content">
    <div class="not-found-wrapper">
      <h1 aria-label="404 Not Found">404</h1>
      <span aria-hidden="true">¯\_(ツ)_/¯</span>
      <p>Page Not Found</p>
      <div class="not-found-links">
        <LinkButton
          href="/"
          className="text-lg underline decoration-dashed underline-offset-8"
        >
          Go back home
        </LinkButton>
        <LinkButton
          href="/posts/"
          className="text-lg underline decoration-dashed underline-offset-8"
        >
          All posts
        </LinkButton>
        <LinkButton
          href="/search/"
          className="text-lg underline decoration-dashed underline-offset-8"
        >
          Search
        </LinkButton>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  @reference "../styles/base.css";

  #main-content {
    @apply mx-auto flex max-w-3xl flex-1 items-center justify-center;
  }
  .not-found-wrapper {
    @apply mb-14 flex flex-col items-center justify-center;
  }
  .not-found-wrapper h1 {
    @apply text-9xl font-bold text-skin-accent;
  }
  .not-found-wrapper p {
    @apply mt-4 text-2xl sm:text-3xl;
  }
  .not-found-links {
    @apply my-6 flex flex-wrap justify-center gap-x-6 gap-y-2;
  }
</style>
