---
import type { CollectionEntry } from "astro:content";
import Card from "@components/Card";
import slugify, { slugifyAll } from "@utils/slugify";

export interface Props {
  post: CollectionEntry<"blog">;
  // Output of getSortedPosts, which the post route already has
  sortedPosts: CollectionEntry<"blog">[];
  limit?: number;
}

const { post, sortedPosts, limit = 3 } = Astro.props;

const currentTags = slugifyAll(post.data.tags);

// Newest first, so posts with the same number of shared tags keep date order
const candidates = sortedPosts
  .filter(({ id }) => id !== post.id)
  .map(candidate => ({
    candidate,
    // Tags like "React" and "react" share a slug, so count it once
    shared: [...new Set(slugifyAll(candidate.data.tags))].filter(tag =>
      currentTags.includes(tag)
    ).length,
  }));

const related = candidates
  .filter(({ shared }) => shared > 0)
  .sort((a, b) => b.shared - a.shared);

// Most posts share no tags, so top up with the latest posts
const picks = [...related, ...candidates.filter(({ shared }) => shared === 0)]
  .slice(0, limit)
  .map(({ candidate }) => candidate);

// Once the list is topped up with unrelated posts it's no longer "related"
const heading = related.length >= picks.length ? "Related posts" : "More posts";
---

{picks.length > 0 && (
  <section class="related-posts" aria-labelledby="related-posts-heading">
    <h2 id="related-posts-heading">{heading}</h2>
    <ul>
      {picks.map(({ data }) => (
        <Card
          href={`/posts/${slugify(data)}/`}
          frontmatter={data}
          secHeading={false}
        />
      ))}
    </ul>
  </section>
)}

<style>
  @reference "../styles/base.css";

  .related-posts {
    @apply mt-8;
  }
  .related-posts h2 {
    @apply text-2xl font-semibold tracking-wide;
  }
</style>
